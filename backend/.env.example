# Groq LLM (required for live AI; demo still runs without it via heuristic fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database — SQLite by default; swap to PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/incident_agent
DATABASE_URL=sqlite:///./incident_agent.db

# Optional HackWithHyd integration (leave empty until credentials are provided)
HACKWITHHYD_API_KEY=
HACKWITHHYD_BASE_URL=

# App
APP_NAME=Incident Response Agent
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Safety: never auto-execute remediations unless you explicitly enable this
AUTO_APPROVE_LOW_RISK=false
