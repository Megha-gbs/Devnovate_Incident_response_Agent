# ==============================================================================
# OPSMIND — Incident Intelligence Platform Environment Configuration
# ==============================================================================

# --- AI & Reasoning Engine ---
# Groq API Key (Optional: when unset, the platform uses an intelligent deterministic diagnostic engine)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Hindsight Organizational Memory ---
# Hindsight API Key (Optional: when unset, the platform uses the indexed local semantic memory bank of 30 historical incidents)
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=org-incident-memory

# --- Database Storage ---
# SQLite by default; seamlessly swap to PostgreSQL when needed:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/incident_agent
DATABASE_URL=sqlite:///./incident_agent.db

# --- Application Server & Security ---
APP_NAME=OPSMIND — Incident Intelligence
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3005,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3005,http://127.0.0.1:5173
AUTO_APPROVE_LOW_RISK=false

# --- Frontend Next.js Configuration ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCK_API=false
